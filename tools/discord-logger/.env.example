# Copy this file to ".env" (same folder) and fill in both values.
# Keep .env private — never commit it, never paste the token in chat.

# Bot token: Developer Portal → your app → Bot → Reset Token → copy.
DISCORD_BOT_TOKEN=

# The general channel's ID: in Discord enable Settings → Advanced → Developer Mode,
# then right-click the channel → Copy Channel ID.
CHANNEL_ID=

# How many recent messages to pull on startup (optional; default 200).
BACKFILL_LIMIT=200

# --- @mention Q&A (optional) ---
# When @mentioned, the bot answers questions about this codebase by running the
# Claude Code CLI (`claude -p`) on YOUR subscription — no API key, no per-call cost.
# Requires: the `claude` CLI installed + logged in, and the bot given "Send Messages"
# permission in the channel. These two are optional tuning knobs:
# BOT_MODEL=            # e.g. claude-haiku-4-5-20251001 to force a cheaper/faster model
# BOT_ANSWER_TIMEOUT_MS=150000
