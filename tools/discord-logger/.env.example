# Copy this file to ".env" (same folder) and fill in both values.
# Keep .env private — never commit it, never paste the token in chat.

# Bot token: Developer Portal → your app → Bot → Reset Token → copy.
DISCORD_BOT_TOKEN=

# The general channel's ID: in Discord enable Settings → Advanced → Developer Mode,
# then right-click the channel → Copy Channel ID.
CHANNEL_ID=

# How many recent messages to pull on startup (optional; default 200).
BACKFILL_LIMIT=200
